# Copy this file to .env.local and fill in your own values. .env.local is
# gitignored and never committed. Everything below except
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY is read server-side only
# (src/lib/ai/config.ts) and never reaches the browser bundle.

# ─── Supabase (accounts + saved whiteboards) ───────────────────────────────
# From Supabase Dashboard → Project Settings → API. All three are server-only
# (no NEXT_PUBLIC_ prefix): the browser never talks to Supabase directly.
SUPABASE_URL=
# The "anon" / publishable key.
SUPABASE_ANON_KEY=
# The "service_role" / secret key. Full database access - keep it secret.
# Used only for alias accounts (scripts/student-alias.mts), clearing the
# first-login flag, account deletion and reading the blocked-domain list.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this app, used in verification/reset email links.
SITE_URL=http://localhost:3000
# Optional: reserved domain for alias accounts (never receives mail).
# ALIAS_EMAIL_DOMAIN=alias.recife-sketch.invalid

# Which AI provider to use. Only "gemini" is implemented right now, but
# the provider is swappable (see src/lib/ai/provider.ts).
AI_PROVIDER=gemini

# Required for the AI tutor to work at all. Get a free key at
# https://aistudio.google.com/app/apikey - the free tier is enough for
# development and light use. Without this set, /api/tutor returns a
# clear "missing_api_key" error instead of crashing.
GEMINI_API_KEY=

# Optional overrides - sensible defaults are used if omitted.
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional backup for HTTP 500/502/503/504; uses the same key and deadline.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# GEMINI_THINKING_LEVEL=low
# AI_MAX_OUTPUT_TOKENS=8192
# AI_MAX_RETRIES=1
# AI_REQUEST_TIMEOUT_MS=45000
# AI_RATE_LIMIT_CAPACITY=8
# AI_RATE_LIMIT_REFILL_PER_SEC=0.1

# Optional: a tldraw license key to remove the "Made with tldraw"
# watermark (https://tldraw.dev/pricing). Unlike the key above, this one
# is NOT a secret - tldraw's own docs have it passed as a plain React
# prop, so it is deliberately exposed to the browser via Next.js's
# NEXT_PUBLIC_ convention. Without it, the whiteboard just shows the
# watermark; nothing else is affected.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Optional: Desmos API key for live graphs (https://www.desmos.com/my-api).
# Loaded by the browser at runtime via /api/desmos; without it, graphs use the built-in plotter.
DESMOS_KEY=
